# PACTA-Bench — ortam değişkenleri şablonu.
# Kullanım:  cp .env.example .env   (sonra .env içine GERÇEK anahtarınızı yazın)
# .env dosyası .gitignore'dadır; ASLA depoya/koda/sohbete gerçek anahtar koymayın.
# g2_pilot.py bu dosyayı otomatik yükler (load_dotenv); shell'de tanımlı değişken önceliklidir.

# Anthropic ajan (--anthropic) veya yargıç (--judge-anthropic) için.
ANTHROPIC_API_KEY=sk-ant-api03-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# OpenAI ajan (--openai) veya yargıç (--judge-openai) için.
OPENAI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXX
QWEN_API_KEY=sk-XXXXXXXXXXXXXXXXXXXX
DEEPSEEK_API_KEY=sk-XXXXXXXXXXXXXXXXXXXX
GEMINI_API_KEY=sk-XXXXXXXXXXXXXXXXXXXX
MONGO_URI=mongodb+srv://<username>:<password>@mongocluster.f4k9e.mongodb.net/?appName=MongoCluster
# (Opsiyonel) OpenAI-uyumlu endpoint (OpenRouter/vLLM vb.); boşsa OpenAI varsayılanı.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
